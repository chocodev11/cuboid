# Build output
/target/
/fuzz/target/

# Fuzzing: crash artifacts and coverage are generated. cargo-fuzz also grows fuzz/corpus/<target>/
# and names every input it generates after its SHA-1 (40 hex digits); those files are ignored. The
# curated seeds committed there (architecture 19.3, W7.2) must have readable names.
/fuzz/artifacts/
/fuzz/coverage/
/fuzz/corpus/*/[0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f]

# Temporary files of atomic writes, test snapshots in review and tool leftovers
*.cubik.tmp
*.tmp
*.snap.new
.*.pending-snap
*.rs.bk
*.profraw
perf.data*

# Editors and operating systems
.idea/
.vscode/
*.swp
*~
.DS_Store
Thumbs.db
desktop.ini

# generated by split_spec.py
docs/_sections/
